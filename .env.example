# S.P.O.T.-IT - detector environment (Docker / Linux hosts)
#
# Copy to .env and fill in. Used by docker-compose.yml.
# On a Windows mini-PC these same values are passed by
# deploy/install-service.ps1 instead, and this file is not needed.
#
# .env is gitignored - it holds a real API key.

# Full URL of ingest_detection.php on the hosted site. main.py derives every
# other endpoint from this, so it is the single value that points the detector
# at the right server.
API_URL=https://spotit.example.com/auth/ingest_detection.php

# Must match SPOTIT_DETECTION_KEY in the site's config/env.local.php.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
API_KEY=PUT_A_LONG_RANDOM_STRING_HERE

# Which room this machine watches. One detector per room, per camera.
ROOM_ID=ROOM_1

# remote = fetch config and commands over HTTP (normal production).
# local  = read config off a shared disk (only if the web app runs on this
#          same machine, e.g. an offline demo).
SPOTIT_DEPLOY=remote
