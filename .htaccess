# ============================================================
# S.P.O.T.-IT — Root .htaccess
# Security rules for the entire project (merged: local XAMPP + Hostinger-ready)
# ============================================================

Options -Indexes -MultiViews
ServerSignature Off

# ── HTTPS redirect ───────────────────────────────────────────────────────────
# Active on any real hostname, skipped on localhost so XAMPP (which has no
# certificate) keeps working. Without this, session cookies and the detection
# API key would cross the internet in clear text.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Deny direct access to sensitive directories + clean URLs ─────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^config/           - [F,L]
  RewriteRule ^services/         - [F,L]
  RewriteRule ^vendor/           - [F,L]

  # Redirect root to landing page
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^ pages/index.php [L,R=301]

  # Clean URL: /login → pages/login.php
  RewriteRule ^login/?$    pages/login.php    [L]
  RewriteRule ^signup/?$   pages/signup.php   [L]
  RewriteRule ^dashboard/? pages/dashboard-admin.php [L]
</IfModule>

# ── Block .sql/.env/.md/.log/.sh/.py files from web access, wherever they sit ─
# (Catches root-level files like main.py, CLAUDE.md, UPDATES.md, BUGS.md, *.sql
#  — a dotfile-only rule alone would miss these since none of them start with
#  a leading dot.)
<FilesMatch "\.(sql|env|md|log|sh|py)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Block access to hidden files (.htaccess, .env, .git) ─────────────────────
<FilesMatch "^\.">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Block detector config files from direct web access ───────────────────────
# These sit in the web root because main.py reads them from disk. Served over
# HTTP they would hand an anonymous visitor the exact pixel coordinates of every
# monitored item, plus which rooms exist and what mode they are in — a map of
# what is watched and, by omission, what is not.
# FilesMatch (not Files) so the per-room variants rois_ROOM_1.json are covered
# too; the old rule named only "rois.json" and missed every production room.
<FilesMatch "^(rois.*\.json|detection_mode\.json|live_roi_state\.json|requirements\.txt|docker-compose\.yml|Dockerfile)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src 'self' https://graph.microsoft.com https://login.microsoftonline.com;"
</IfModule>

# ── PHP settings ──────────────────────────────────────────────────────────────
# Upload/memory limits raised for webcam claim photos (complete_claim.php) and
# forum/announcement attachments.
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
  php_value session.cookie_httponly 1
  php_value session.cookie_samesite "Lax"
  php_value session.use_strict_mode 1
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
  php_value max_execution_time 60
  php_value memory_limit 256M
</IfModule>

# ── Gzip compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── File caching for assets ───────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css             "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg           "access plus 30 days"
  ExpiresByType image/png            "access plus 30 days"
  ExpiresByType image/webp           "access plus 30 days"
</IfModule>

# ── Protect .htaccess itself ──────────────────────────────────────────────────
<Files .htaccess>
  Order Allow,Deny
  Deny from all
</Files>
